# Copiar a .env y completar. El .env nunca se sube al repositorio.
# Los valores entre comillas simples se toman literalmente (sin interpretar $ ni espacios).

# ── Archivos de Docker Compose ────────────────────────────────────────────────
# Servidor: suma docker-compose.servidor.yml, que conecta sgi-web a la red del portal de I+D.
# En desarrollo se usa -f docker-compose.yml -f docker-compose.dev.yml (ver README).
COMPOSE_FILE=docker-compose.yml:docker-compose.servidor.yml

# ── Origen: disco I de SGI (recurso compartido SMB, solo lectura) ─────────────
SMB_SERVIDOR=192.168.41.5
SMB_RECURSO=iso
# Cuenta de servicio de solo lectura provista por IT.
# La clave no puede contener comas (Docker la pasa dentro de una lista separada por comas).
SMB_USUARIO=
SMB_CLAVE=''
SMB_DOMINIO=WORKGROUP
# Windows Server 2008 R2 admite hasta SMB 2.1
SMB_VERSION=2.1

# ── Sincronización ────────────────────────────────────────────────────────────
# Formato cron: minuto hora día-del-mes mes día-de-la-semana. Por defecto, todos los días a las 6:00.
SYNC_HORARIO='0 6 * * *'
TZ=America/Argentina/Buenos_Aires
# Copias que se conservan, contando la publicada.
SYNC_CONSERVAR=3
# La copia nueva se publica solo si tiene al menos esta proporción de los archivos de la
# publicada. Protege ante un disco que responde a medias. Para saltear el control a mano:
#   docker compose exec sgi-sync sincronizar --forzar
SYNC_MIN_PROPORCION=0.9

# ── Portal ────────────────────────────────────────────────────────────────────
# Aclaración destacada debajo del título de la home.
PORTAL_AVISO='Información documentada del Sistema de Gestión Integrado. La versión vigente es la publicada en este portal; toda copia impresa o descargada se considera no controlada.'
# Cómo ve SGI la raíz del disco en Windows: el reporte muestra las rutas así (I:\01. MANUALES…).
# (comillas dobles y barra doble: Docker lee "I:\\" como I:\)
PORTAL_RUTA_DISCO="I:\\"
# Archivos y carpetas que no se publican (comodines; terminado en / = solo carpetas).
PORTAL_EXCLUSIONES='aspnet_client/, web.config, Thumbs.db, desktop.ini, ~$*, .~lock.*#, *.tmp, .*'

# ── Solo desarrollo local (docker-compose.dev.yml) ────────────────────────────
# Copia del disco en esta PC, usada en lugar del recurso SMB.
SGI_DISCO_LOCAL=C:/Temp/DocumentacionISO
